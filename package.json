{
  "name": "motionface-xiaoke-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "A Remotion recreation of a hand-drawn video editing vignette.",
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3001",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts XiaokeEdit out/xiaoke.mp4",
    "still": "remotion still src/index.ts XiaokeEdit out/xiaoke.png"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.533",
    "@types/node": "22.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.8.3"
  }
}
